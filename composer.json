{
    "name": "tqt97/php-design-patterns-handbook",
    "description": "A practical PHP Design Patterns handbook for learning and training",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.60",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "DesignPatterns\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "fix": "php-cs-fixer fix",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "validate-repo": "php scripts/validate-repository.php",
        "playgrounds": "bash scripts/run-playgrounds.sh",
        "katas": "bash scripts/run-katas.sh",
        "examples": "bash scripts/run-examples.sh",
        "benchmarks": "bash scripts/run-benchmarks.sh",
        "quality": [
            "@validate-repo",
            "@content-integrity",
            "@content-audit",
            "@domain-specific-content-audit",
            "@semantic-audit",
            "@readme-audit",
            "@folder-enterprise-depth-audit",
            "@artifact-alignment-audit",
            "@internal-heading-audit",
            "@cross-file-uniqueness-audit",
            "@short-duplication-audit",
            "@editorial-audit",
            "@repetition-audit",
            "@strict-repetition-audit",
            "@folder-uniqueness-audit",
            "@exercise-independence-audit",
            "@exercise-design-audit",
            "@learning-depth-audit",
            "@expert-readiness-audit",
            "@topic-depth-audit",
            "@topic-diagram-audit",
            "@learning-experience-audit",
            "@handbook-mental-model-audit",
            "@examples",
            "@playgrounds",
            "@katas",
            "@production-design-audit",
            "@playground-design-audit",
            "@source-map-audit",
            "@topic-code-alignment-audit",
            "@final-release-audit",
            "@release-quality-audit",
            "@enterprise-content-audit",
            "@enterprise-practicality-audit",
            "@enterprise-release-v2-audit",
            "@architecture-fitness-audit",
            "@property-workbook",
            "@failure-injection-lab",
            "@expert-practice-v2-audit",
            "@enterprise-simulation-coverage-audit",
            "@source-smoke",
            "@check"
        ],
        "content-integrity": "php scripts/check-content-integrity.php",
        "content-audit": "php scripts/audit-content.php",
        "source-smoke": "php scripts/run-source-smoke-tests.php",
        "semantic-audit": "php scripts/audit-semantic-alignment.php",
        "readme-audit": "php scripts/audit-readmes.php",
        "editorial-audit": "php scripts/audit-editorial-quality.php",
        "repetition-audit": "php scripts/audit-repeated-paragraphs.php",
        "learning-depth-audit": "php scripts/audit-learning-depth.php",
        "expert-readiness-audit": "php scripts/audit-expert-readiness.php",
        "source-map-audit": "php scripts/audit-source-map.php",
        "strict-repetition-audit": "php scripts/audit-strict-repetition.php",
        "production-design-audit": "php scripts/audit-production-design.php",
        "playground-design-audit": "php scripts/audit-playground-design.php",
        "folder-uniqueness-audit": "php scripts/audit-folder-uniqueness.php",
        "exercise-independence-audit": "php scripts/audit-exercise-independence.php",
        "topic-depth-audit": "php scripts/audit-topic-depth.php",
        "exercise-design-audit": "php scripts/audit-exercise-design-models.php",
        "topic-diagram-audit": "php scripts/audit-topic-diagrams.php",
        "learning-experience-audit": "php scripts/audit-learning-experience.php",
        "handbook-mental-model-audit": "php scripts/audit-handbook-mental-models.php",
        "final-release-audit": "php scripts/audit-final-release.php",
        "release-quality-audit": "php scripts/audit-release-quality.php",
        "internal-heading-audit": "php scripts/audit-internal-headings.php",
        "cross-file-uniqueness-audit": "php scripts/audit-cross-file-uniqueness.php",
        "short-duplication-audit": "php scripts/audit-short-duplication.php",
        "enterprise-content-audit": "php scripts/audit-enterprise-content.php",
        "enterprise-practicality-audit": "php scripts/audit-enterprise-practicality.php",
        "enterprise-release-v2-audit": "php scripts/audit-enterprise-release-v2.php",
        "artifact-alignment-audit": "php scripts/audit-artifact-alignment.php",
        "folder-enterprise-depth-audit": "php scripts/audit-folder-enterprise-depth.php",
        "architecture-fitness-audit": "php scripts/audit-architecture-fitness.php",
        "property-workbook": "php expert-labs/property-based-invariants/run.php 20260802 500",
        "failure-injection-lab": "php expert-labs/failure-injection/run.php 42",
        "expert-practice-v2-audit": "php scripts/audit-expert-practice-v2.php",
        "topic-code-alignment-audit": "php scripts/audit-topic-code-alignment.php",
        "enterprise-simulation-coverage-audit": "php scripts/audit-enterprise-simulation-coverage.php",
        "domain-specific-content-audit": "php scripts/audit-domain-specific-content.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
